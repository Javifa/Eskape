# ============================================================================
# VARIABLES DE ENTORNO — PROYECTO INDEPENDIENTE DE SUPABASE PARA ESKAPE
# ============================================================================
# IMPORTANTE:
# 1. Crea un proyecto NUEVO y exclusivo para ESKAPE en https://supabase.com
#    (NUNCA utilices el proyecto ni las credenciales de FACENIA u otros clientes).
# 2. Copia este archivo como `.env` en la raíz del proyecto local y configura
#    estas dos variables en el panel de Vercel (Settings > Environment Variables).
# 3. NUNCA incluyas la clave privada `service_role` en el frontend.

VITE_SUPABASE_URL=https://TU_PROYECTO_EXCLUSIVO_ESKAPE.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica_de_eskape
